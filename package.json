{
  "name": "uni-app-schemas-vscode",
  "displayName": "uni-app-schemas",
  "version": "0.9.13",
  "description": "校验 uni-app 中的 androidPrivacy.json、pages.json 和 manifest.json 格式",
  "categories": [
    "Other"
  ],
  "keywords": [
    "uniapp",
    "uni-app",
    "schema",
    "schemas",
    "pages",
    "pages.json",
    "manifest",
    "manifest.json",
    "androidPrivacy",
    "androidPrivacy.json"
  ],
  "homepage": "https://github.com/uni-helper/uni-app-schemas-vscode#readme",
  "bugs": {
    "url": "https://github.com/uni-helper/uni-app-schemas-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/uni-app-schemas-vscode.git"
  },
  "license": "MIT",
  "author": {
    "name": "ModyQyW",
    "email": "wurui.dev@gmail.com",
    "url": "https://modyqyw.top"
  },
  "publisher": "uni-helper",
  "type": "module",
  "files": [
    "schemas",
    "LICENSE",
    "logo.png"
  ],
  "scripts": {
    "build": "conc \"npm:build:manifest-schema\" \"npm:build:pages-schema\" && npm run fix",
    "build:manifest-schema": "cp node_modules/@uni-helper/manifest-json-schema/schema.json schemas/manifest.json",
    "build:pages-schema": "cp node_modules/@uni-helper/pages-json-schema/schema.json schemas/pages.json",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "publish": "conc \"npm:publish:vscode\" \"npm:publish:openvsx\"",
    "publish:openvsx": "ovsx publish",
    "publish:vscode": "vsce package && vsce publish",
    "release": "npm run build && git add ./schemas/*.json && bumpp --all"
  },
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "androidPrivacy.json",
        "url": "./schemas/androidPrivacy.json"
      },
      {
        "fileMatch": "pages.json",
        "url": "./schemas/pages.json"
      },
      {
        "fileMatch": "manifest.json",
        "url": "./schemas/manifest.json"
      }
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@uni-helper/manifest-json-schema": "^0.6.0",
    "@uni-helper/pages-json-schema": "^0.5.0",
    "@vscode/vsce": "^3.9.2",
    "bumpp": "^12.3.0",
    "concurrently": "^10.0.5",
    "ovsx": "^1.2.0",
    "ultracite": "^7.12.0"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "vscode": "^1.40.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "warn"
    }
  },
  "icon": "logo.png",
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": true,
    "fsevents@2.3.3": true,
    "keytar@7.9.0": true
  },
  "sponsor": {
    "url": "https://github.com/ModyQyW/sponsors"
  }
}
